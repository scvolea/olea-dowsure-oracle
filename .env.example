# dowsure-oracle source-client adapter - example environment file.
#
# Copy to `.env` and fill in values ONLY for sandbox mode. `.env` is gitignored
# and must NEVER be committed. Mock mode (the default) needs ZERO credentials.
#
#   cp .env.example .env    # then edit .env, never this file
#
# Every value below is a placeholder. Do not paste real secrets into .env.example.

# ---------------------------------------------------------------------------
# Mode switch
# ---------------------------------------------------------------------------
# mock    = talk to the API Gateway contract mocks (no creds). Default.
# sandbox = talk to the real provider sandbox/hosts (needs the creds below).
SOURCE_MODE=mock

# ---------------------------------------------------------------------------
# Deployed mock API key (mock mode, when the mock stacks are API-key gated)
# ---------------------------------------------------------------------------
# Sent as the x-api-key header to the deployed mocks. Leave EMPTY for a local
# stub (e.g. `source-smoke.py --self-test`).
# WHERE: API Gateway console > APIs > (amazon-sp or kyc mock) > API Keys, or copy
# the ApiKeyId from the stack Outputs and fetch the value with:
#   aws apigateway get-api-key --api-key <ApiKeyId> --include-value \
#       --profile preprod --region ap-southeast-1
MOCK_API_KEY=

# ---------------------------------------------------------------------------
# Per-provider base URLs
# ---------------------------------------------------------------------------
# MOCK mode: set these to each deployed mock stack's `ApiUrl` stack output
#   (CloudFormation > Stacks > amazon-sp-contract-mock / kyc-contract-mock >
#    Outputs > ApiUrl). Leaving them empty falls back to a harmless localhost
#   default used by the self-test stub.
# SANDBOX mode: leave empty to use the built-in real-host defaults, or override
#   with a specific host if the provider gives you a different endpoint.
AMAZON_SP_BASE_URL=
ALICLOUD_BASE_URL=
QICHACHA_BASE_URL=
GUTU_BASE_URL=

# ---------------------------------------------------------------------------
# Amazon SP-API (sandbox mode only) - LWA credentials
# ---------------------------------------------------------------------------
# WHERE: Amazon SP-API developer console > Apps & Services > your app > "LWA
#   credentials" shows the client id and secret. The refresh token comes from
#   completing the app authorization (OAuth) flow for your seller account.
LWA_CLIENT_ID=
LWA_CLIENT_SECRET=
LWA_REFRESH_TOKEN=
# Optional: only set to enable the SigV4 region hook. Not required for the
# sandbox fixtures. WHERE: the AWS region of your SP-API role (e.g. us-east-1).
AWS_REGION=

# ---------------------------------------------------------------------------
# AliCloud three-element verification (sandbox mode only)
# ---------------------------------------------------------------------------
# Sent as the `Authorization: APPCODE <value>` header.
# WHERE: Aliyun console > API Market > your subscribed API > "AppCode".
ALICLOUD_APPCODE=

# ---------------------------------------------------------------------------
# Qichacha enterprise/judicial checks (sandbox mode only)
# ---------------------------------------------------------------------------
# Token = md5(QICHACHA_APP_KEY + Timespan + QICHACHA_SECRET_KEY), sent with the
# key + Timespan headers.
# WHERE: Qichacha open-platform console > My Data > Key Management shows the app
#   key and secret key.
QICHACHA_APP_KEY=
QICHACHA_SECRET_KEY=
# Optional fixed Timespan (epoch seconds) for the signature. Usually generated
# per request; set only if you need a pinned value for a specific test.
QICHACHA_TIMESPAN=

# ---------------------------------------------------------------------------
# Gutu / Valuemap judicial panorama (sandbox mode only)
# ---------------------------------------------------------------------------
# Sent as the `Authorization: Bearer <value>` header.
# WHERE: Gutu/Valuemap tenant console > API access > API access token.
GUTU_TOKEN=
